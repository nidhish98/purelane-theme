    "theme_version": "1.0.0",
    "theme_author": "Troopod",
    "theme_documentation_url": "https://github.com/nidhish98/purelane-theme",
    "theme_support_url": "https://github.com/nidhish98/purelane-theme"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "color",
        "id": "color_theme_color",
        "label": "Browser theme colour",
        "default": "#eee7fb"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#f4f0fb"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Headings",
        "default": "#17102b"
      },
      {
        "type": "color",
        "id": "color_paper",
        "label": "Body text",
        "default": "#241a3d"
      },
      {
        "type": "color",
        "id": "color_brand",
        "label": "Brand purple",
        "default": "#4b3a8f"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (amber)",
        "default": "#b8701c"
      },
      {
        "type": "color",
        "id": "color_leaf",
        "label": "Leaf green (accents, focus)",
        "default": "#4f7d10"
      }
    ]
  },
  {
    "name": "Motion",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_scene_effects",
        "label": "Enable scroll-driven background scene effect",
        "default": true,
        "info": "Crossfades the page background between the four brand gradients as you scroll. Respects 'prefers-reduced-motion'."
      },
      {
        "type": "checkbox",
        "id": "enable_water_effect",
        "label": "Enable subtle water light effect",
        "default": true,
        "info": "Renders lightweight light-shaft and surface-sheen layers behind the page content. Disable for maximum performance."
      },
      {
        "type": "checkbox",
        "id": "enable_reveal",
        "label": "Enable reveal-on-scroll animations",
        "default": true
      }
    ]
  }
]
