            "product": "Laundry detergent"
          }
        },
        "review-2": {
          "type": "review",
          "settings": {
            "rating": "5",
            "title": "Gentle on hands",
            "body": "Finally a dishwash gel that cuts through grease without leaving my hands dry. Love the lemon scent and how little I need per wash.",
            "name": "Priya",
            "product": "Dishwash gel"
          }
        },
        "review-3": {
          "type": "review",
          "settings": {
            "rating": "5",
            "title": "The whole family switched",
            "body": "Gentle on hands, and the whole family has switched. The pump lasts ages and it lathers beautifully.",
            "name": "Sunita",
            "product": "Liquid handwash"
          }
        },
        "review-4": {
          "type": "review",
          "settings": {
            "rating": "5",
            "title": "Handles hard water",
            "body": "The floor cleaner actually handles tiles and hard water stains. My floors look fresh and smell subtle, not like chemicals.",
            "name": "Rohit S.",
            "product": "Floor cleaner"
          }
        },
        "review-5": {
          "type": "review",
          "settings": {
            "rating": "5",
            "title": "Took off the limescale",
            "body": "Took off limescale that older cleaners left behind. Impressed that it is plant-based and still this effective.",
            "name": "Verified buyer",
            "product": "Tap cleaner"
          }
        }
      },
