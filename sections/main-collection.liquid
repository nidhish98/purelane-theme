{%- comment -%}
  MAIN COLLECTION (collection page template). On-brand grid reusing the
  product card snippet, with pagination.
{%- endcomment -%}
<section class="pl-page sec" data-scene="3">
  <div class="wrap">
    <div class="pl-page-head">
      <h1 class="d2">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="lede">{{ collection.description }}</p>
      {%- endif -%}
    </div>

    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <div class="shelf">
          {%- for product in collection.products -%}
            {%- assign d = forloop.index0 | modulo: 4 | plus: 1 -%}
            {% render 'product-card', product: product, delay: d %}
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="pl-pagination" aria-label="{{ 'general.pagination.label' | t }}">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span{% if part.title == paginate.current_page %} class="on" aria-current="page"{% endif %}>{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="pl-empty">{{ 'collections.general.empty' | t }}</div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "shopify-section-main-collection",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}