{%- comment -%}
  FULL RANGE — "Every room, one shelf" (secondary). A horizontal product
  strip driven by a product list setting.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 3 }}">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading | escape | newline_to_br }}</h2>
        </div>
        {%- if section.settings.description != blank -%}
          <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.description | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.products.size > 0 -%}
        <div class="stripwrap">
          <div class="rangerow">
            {%- for product in section.settings.products -%}
              {%- if product.featured_image -%}
                <img class="pimg" src="{{ product.featured_image | image_url: width: 220 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy">
              {%- else -%}
                <span class="tile">{% render 'icon', icon: 'leaf', size: 20 %}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.strip_hint != blank -%}
        <p class="striphint">{{ section.settings.strip_hint | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Full range strip",
  "tag": "section",
  "class": "shopify-section-full-range",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "range"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "info": "Shown as a scrolling strip of product images."
    },
    {
      "type": "text",
      "id": "strip_hint",
      "label": "Swipe hint",
      "default": "Swipe to see the full shelf"
    }
  ]
}
{% endschema %}