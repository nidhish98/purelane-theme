{%- comment -%}
  BEST-SELLING COMBOS (priority section 3).
  A snap-scrolling rail of pre-built bundle cards. Each card is one block:
  the merchant picks up to three products (imagery) plus the offer copy.
  Prices here are flat bundle prices — a marketing construct with no native
  Shopify field — so they are merchant-editable text.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 3 }}">
  <div class="wrap">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {%- assign d = forloop.index0 | modulo: 4 | plus: 1 -%}
        <article class="glass combo{% if block.settings.flag != blank %} hero-combo{% endif %} rv rv-d{{ d }}" {{ block.shopify_attributes }}>
          <div class="tray">
            {%- if block.settings.save_text != blank -%}
              <span class="save">{{ block.settings.save_text | escape }}</span>
            {%- endif -%}
            {%- if block.settings.flag != blank -%}
              <span class="flag">{{ block.settings.flag | escape }}</span>
            {%- endif -%}
            <div class="stack">
              {%- assign item_idx = 0 -%}
              {%- for i in (1..3) -%}
                {%- assign pkey = 'product_' | append: i -%}
                {%- assign lkey = 'product_' | append: i | append: '_label' -%}
                {%- assign p = block.settings[pkey] -%}
                {%- if p != blank -%}
                  {%- if item_idx > 0 -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
                  <span class="it">
                    {%- if p.featured_image -%}
                      <img class="pimg" src="{{ p.featured_image | image_url: width: 220 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy">
                    {%- else -%}
                      <span class="tile">{% render 'icon', icon: 'leaf', size: 17 %}</span>
                    {%- endif -%}
                    <span>{{ block.settings[lkey] | default: p.title | escape }}</span>
                  </span>
                  {%- assign item_idx = item_idx | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>

          <div class="body">
            {%- if block.settings.title != blank -%}
              <h3>{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.count_label != blank -%}
              <div class="cnt">{{ block.settings.count_label | escape }}</div>
            {%- endif -%}
            {%- if block.settings.description != blank -%}
              <p class="inc">{{ block.settings.description | escape }}</p>
            {%- endif -%}
            <div class="prow">
              <strong>{{ block.settings.price | escape }}</strong>
              {%- if block.settings.compare_at_price != blank -%}<s>{{ block.settings.compare_at_price | escape }}</s>{%- endif -%}
              {%- if block.settings.save_text != blank -%}<em>{{ block.settings.save_text | escape }}</em>{%- endif -%}
            </div>
            {%- if block.settings.fine_print != blank -%}
              <div class="fine">{{ block.settings.fine_print | escape }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="btn btn-ghost" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label | escape }}
                {% render 'icon', icon: 'arrow', size: 15, stroke: 2.2 %}
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_swipe_cue -%}
      <div class="swipecue" aria-hidden="true">
        {% render 'icon', icon: 'arrow', size: 14, stroke: 2.2 %}
        {{ section.settings.swipe_cue | escape }}
      </div>
    {%- endif -%}
    {%- if section.settings.rail_note != blank -%}
      <p class="railnote">{{ section.settings.rail_note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "shopify-section-combos",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "combos"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "checkbox",
      "id": "show_swipe_cue",
      "label": "Show swipe hint",
      "default": true
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe hint text",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Footnote",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "text",
          "id": "count_label",
          "label": "Product count label",
          "default": "3 products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Includes text",
          "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare-at price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "save_text",
          "label": "Savings pill",
          "default": "Save ₹398"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "Flag (optional)",
          "info": "e.g. 'Most popular'. Shows an accent flag and highlight ring.",
          "default": "Most popular"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine print",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop bundle"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "text",
          "id": "product_1_label",
          "label": "Product 1 caption",
          "default": "Cuts grease instantly"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "text",
          "id": "product_2_label",
          "label": "Product 2 caption",
          "default": "Squeaky clean dishes"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "text",
          "id": "product_3_label",
          "label": "Product 3 caption",
          "default": "Melts hard water stains"
        }
      ]
    }
  ]
}
{% endschema %}