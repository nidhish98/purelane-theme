{%- comment -%}
  PILLARS — "How it works" cards (secondary). One block per pillar.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 2 }}">
  <div class="wrap">
    <div class="pillars">
      {%- for block in section.blocks -%}
        {%- assign d = forloop.index0 | modulo: 3 | plus: 1 -%}
        <article class="glass pillar rv rv-d{{ d }}" {{ block.shopify_attributes }}>
          <span class="pi">{% render 'icon', icon: block.settings.icon, size: 24, stroke: 1.6 %}</span>
          <h3 class="d3">{{ block.settings.title | escape }}</h3>
          <p class="body-s">{{ block.settings.body | escape }}</p>
          {%- if block.settings.button_label != blank -%}
            <a class="btn btn-ghost btn-sm" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars (how it works)",
  "tag": "section",
  "class": "shopify-section-pillars",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "how"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 3,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "bubbles", "label": "Bubbles" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check-square", "label": "Check square" },
            { "value": "truck", "label": "Truck" }
          ],
          "default": "bubbles"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ]
}
{% endschema %}