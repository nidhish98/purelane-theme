{%- comment -%}
  PROOF — "Why it works" (secondary). Copy column, an auto-rotating product
  frame and a stats strip. Stats and rotator products are blocks.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 3 }}" data-pl-module="proof">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.body | escape }}</p>
          {%- if section.settings.button_label != blank -%}
            <a class="btn btn-primary" href="{{ section.settings.button_link }}">
              {{ section.settings.button_label | escape }}
              {% render 'icon', icon: 'arrow', size: 15, stroke: 2.2 %}
            </a>
          {%- endif -%}
        </div>

        {%- liquid
          assign has_products = false
          for block in section.blocks
            if block.type == 'product'
              assign has_products = true
            endif
          endfor
          assign first_name = ''
          assign first_note = ''
        -%}
        {%- if has_products -%}
          {%- assign seen_first = false -%}
          <div class="glass-2 rot" data-rotator aria-hidden="true">
            <div class="frame">
              {%- for block in section.blocks -%}
                {%- if block.type == 'product' and block.settings.product != blank and block.settings.product.featured_image -%}
                  {%- assign name = block.settings.name | default: block.settings.product.title -%}
                  {%- assign note = block.settings.note -%}
                  {%- if seen_first == false -%}
                    {%- assign first_name = name -%}
                    {%- assign first_note = note -%}
                  {%- endif -%}
                  <img class="pimg{% if seen_first == false %} on{% endif %}" src="{{ block.settings.product.featured_image | image_url: width: 320 }}" alt="{{ block.settings.product.featured_image.alt | default: block.settings.product.title | escape }}" loading="lazy" data-name="{{ name | escape }}" data-note="{{ note | escape }}">
                  {%- assign seen_first = true -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="cap"><b>{{ first_name | escape }}</b><span>{{ first_note | escape }}</span></div>
            <div class="dots">
              {%- assign dseen = false -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'product' and block.settings.product != blank and block.settings.product.featured_image -%}
                  <i{% if dseen == false %} class="on"{% endif %}></i>
                  {%- assign dseen = true -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- assign has_stats = false -%}
        {%- for block in section.blocks -%}{% if block.type == 'stat' %}{% assign has_stats = true %}{% endif %}{% endfor -%}
        {%- if has_stats -%}
          <div class="glass-2 stats proof-stats">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="stat">
                  <div class="ring">{{ block.settings.value | escape }}</div>
                  <h5>{{ block.settings.label | escape }}</h5>
                  <p>{{ block.settings.subtext | escape }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof (why it works)",
  "tag": "section",
  "class": "shopify-section-proof",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "proof"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime.\nGentle on everything else."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Germ kill"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Supporting text",
          "default": "Tested against germs and bacteria"
        }
      ]
    },
    {
      "type": "product",
      "name": "Rotator product",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Short name",
          "info": "Optional. Defaults to the product title."
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Foam lifts grease, no scrubbing"
        }
      ]
    }
  ]
}
{% endschema %}