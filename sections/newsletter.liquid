{%- comment -%}
  NEWSLETTER SIGNUP (secondary). Uses Shopify's customer form so it works
  with the real newsletter subscription flow; success / error states are
  rendered from the form object.
{%- endcomment -%}
<section class="sec" data-scene="{{ section.settings.scene | default: 4 }}">
  <div class="wrap">
    <div class="glass signup rv">
      {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="lede" style="margin:0 auto">{{ section.settings.lede | escape }}</p>{%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.placeholder | escape }}"
          aria-label="{{ 'newsletter.placeholder' | t }}"
          required
          {% if form.errors %}aria-invalid="true"{% endif %}>
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label | escape }}</button>

        {%- if form.posted_successfully? -%}
          <p class="newsletter-note" style="flex-basis:100%">{{ 'newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="newsletter-note" style="flex-basis:100%;color:#a13b2e">{{ 'newsletter.error' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "tag": "section",
  "class": "shopify-section-newsletter",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting text",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Get my ₹100 off"
    }
  ]
}
{% endschema %}