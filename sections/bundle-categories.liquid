{%- comment -%}
  BUNDLE CATEGORIES — "Find the right bundle" (secondary). One block per
  category card; imagery comes from a picked product.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 4 }}">
  <div class="wrap">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      rule: false
    %}
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign d = forloop.index0 | modulo: 4 | plus: 1 -%}
        <a class="glass cat rv rv-d{{ d }}" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {%- if block.settings.product != blank and block.settings.product.featured_image -%}
              <img class="pimg" src="{{ block.settings.product.featured_image | image_url: width: 300 }}" alt="{{ block.settings.product.featured_image.alt | default: block.settings.product.title | escape }}" loading="lazy">
            {%- else -%}
              <span class="tile">{% render 'icon', icon: 'leaf', size: 30 %}</span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.subtitle | escape }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle categories",
  "tag": "section",
  "class": "shopify-section-categories",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "categories"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}