{%- comment -%}
  INGREDIENTS — "Sourced from nature" (secondary). Icon art + name +
  description per block, matching the prototype's botanical line art.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 2 }}">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br }}</h2>
        <div class="rule"><i></i>{% render 'icon', icon: 'leaf', size: 16, stroke: 1.6 %}<i></i></div>
      </div>
      <div class="ing">
        {%- for block in section.blocks -%}
          <div class="ing-i" {{ block.shopify_attributes }}>
            <div class="art">
              {%- case block.settings.icon -%}
                {%- when 'coconut' -%}
                  <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="50" cy="62" r="25"/>
                    <path d="M31 53c9-6 29-6 38 0" stroke="#f0a03c"/>
                    <path d="M41 63c4 8 14 8 18 0" opacity=".55"/>
                    <path d="M50 37V25"/>
                    <path d="M50 27C42 18 30 16 21 21c5 10 17 13 29 6Z" stroke="#f0a03c"/>
                    <path d="M50 27c8-9 20-11 29-6-5 10-17 13-29 6Z" stroke="#f0a03c"/>
                  </svg>
                {%- when 'orange' -%}
                  <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="45" cy="58" r="23"/>
                    <path d="M45 35v46M22 58h46" opacity=".4"/>
                    <path d="M29 42 61 74M61 42 29 74" opacity=".26"/>
                    <path d="M62 28c13-1 20 10 15 20-4 8-15 9-19 2" stroke="#f0a03c"/>
                    <path d="M45 34c-3-8 2-15 10-16 1 9-3 15-10 16Z" stroke="#f0a03c"/>
                  </svg>
                {%- when 'soapnut' -%}
                  <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="36" cy="66" r="16"/>
                    <circle cx="64" cy="69" r="14"/>
                    <circle cx="50" cy="43" r="14"/>
                    <path d="M50 29V17"/>
                    <path d="M50 21c-8-8-18-8-23-2 7 8 17 10 23 2Z" stroke="#f0a03c"/>
                    <path d="M31 60a5 5 0 0 1 4-4" opacity=".6"/>
                    <path d="M46 38a5 5 0 0 1 4-4" opacity=".6"/>
                  </svg>
                {%- when 'neem' -%}
                  <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 82C36 66 58 44 82 20" stroke="#f0a03c"/>
                    <path d="M27 73c-6-7-4-15 3-18 4 7 3 14-3 18Z"/>
                    <path d="M31 69c8-4 15 0 16 8-8 2-14-1-16-8Z"/>
                    <path d="M41 59c-6-7-4-16 3-19 4 7 3 15-3 19Z"/>
                    <path d="M45 55c9-4 16 0 17 8-8 2-15-1-17-8Z"/>
                    <path d="M56 44c-6-7-4-16 3-19 4 7 3 15-3 19Z"/>
                    <path d="M60 40c9-4 16 0 17 8-8 2-15-1-17-8Z"/>
                    <path d="M70 30c-5-7-3-15 4-18 3 7 2 14-4 18Z"/>
                  </svg>
                {%- when 'lemongrass' -%}
                  <svg viewBox="0 0 100 100" fill="none">
                    <g fill="#ece6f7" opacity=".88">
                      <path d="M50 88C44 62 39 42 24 15c15 27 22 47 29 73Z"/>
                      <path d="M52 88C50 60 50 39 44 9c11 29 13 50 12 79Z"/>
                      <path d="M54 88C56 60 60 40 74 13c-11 28-15 48-16 75Z"/>
                      <path d="M56 88C60 64 68 48 86 27c-14 22-21 38-26 61Z"/>
                      <path d="M48 88C44 66 36 50 18 30c14 21 22 36 27 58Z"/>
                    </g>
                    <path d="M50 88h6" stroke="#f0a03c" stroke-width="2.4" stroke-linecap="round"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 100 100" fill="none" stroke="#ece6f7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="50" cy="62" r="25"/>
                    <path d="M31 53c9-6 29-6 38 0" stroke="#f0a03c"/>
                  </svg>
              {%- endcase -%}
            </div>
            <h4>{{ block.settings.name | escape }}</h4>
            <p>{{ block.settings.description | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "shopify-section-ingredients",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "ingredients"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "2"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Sourced from nature"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sourced from nature"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange", "label": "Orange peel" },
            { "value": "soapnut", "label": "Soap nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Coconut"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ]
}
{% endschema %}