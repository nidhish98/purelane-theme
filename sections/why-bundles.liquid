{%- comment -%}
  WHY BUNDLES — benefit tiles (secondary). One block per benefit.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 4 }}">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br }}</h2>
      </div>
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">{% render 'icon', icon: block.settings.icon, size: 25, stroke: 1.6 %}</span>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why bundles",
  "tag": "section",
  "class": "shopify-section-why-bundles",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "whybundles"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why bundles beat buying single"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "rupee", "label": "Rupee" },
            { "value": "check-square", "label": "Check square" },
            { "value": "star", "label": "Star" },
            { "value": "truck", "label": "Truck" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "rupee"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "body",
          "label": "Body text",
          "default": "Versus buying the same products separately"
        }
      ]
    }
  ]
}
{% endschema %}