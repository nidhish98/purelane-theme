{%- comment -%}
  BUNDLES (priority section 4).
  Three (or more) flat-price bundle tiers. Each tier is a block: tag,
  quantity, prices, per-product note, feature list and up to five products
  for the strip. Bundle prices are merchant-set (no native Shopify field
  for a flat bundle price); imagery comes from the picked products.
{%- endcomment -%}
<section id="{{ section.settings.anchor_id | escape }}" class="sec" data-scene="{{ section.settings.scene | default: 3 }}">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="glass sec-pad rv" style="margin-bottom:16px">
        <div class="panel-head" style="margin-bottom:0">
          {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}<h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
          {%- if section.settings.lede != blank -%}<p class="lede" style="margin:0 auto">{{ section.settings.lede | escape }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- liquid
          assign n = 0
          for i in (1..5)
            assign pkey = 'product_' | append: i
            if block.settings[pkey] != blank
              assign n = n | plus: 1
            endif
          endfor
          assign features = block.settings.features | newline_to_br | split: '<br />'
          assign d = forloop.index0 | modulo: 3 | plus: 1
        -%}
        <article class="glass tier{% if block.settings.featured %} best{% endif %} rv rv-d{{ d }}" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}

          <div class="tierpix{% if n > 3 %} five{% endif %}" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- assign pkey = 'product_' | append: i -%}
              {%- assign p = block.settings[pkey] -%}
              {%- if p != blank -%}
                {%- if p.featured_image -%}
                  <img class="pimg" src="{{ p.featured_image | image_url: width: 160 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" loading="lazy">
                {%- else -%}
                  <span class="tile">{% render 'icon', icon: 'leaf', size: 17 %}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="qty">{{ block.settings.qty }}<small>{{ block.settings.qty_label | escape }}</small></div>
          <div class="price">
            {{ block.settings.price | escape }}
            {%- if block.settings.compare_at_price != blank -%}<s>{{ block.settings.compare_at_price | escape }}</s>{%- endif -%}
          </div>
          {%- if block.settings.per_unit_note != blank -%}
            <p class="body-s" style="font-size:12px">{{ block.settings.per_unit_note | escape }}</p>
          {%- endif -%}

          {%- if features.size > 0 -%}
            <ul>
              {%- for feature in features -%}
                {%- if feature != '' -%}
                  <li>{% render 'icon', icon: 'check', size: 14, stroke: 2.4 %}{{ feature | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            {%- if block.settings.featured -%}
              <a class="btn btn-primary" href="{{ block.settings.button_link }}">
                {{ block.settings.button_label | escape }}
                {% render 'icon', icon: 'arrow', size: 15, stroke: 2.2 %}
              </a>
            {%- else -%}
              <a class="btn btn-ghost" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
            {%- endif -%}
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "shopify-section-bundles",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor id",
      "default": "bundles"
    },
    {
      "type": "select",
      "id": "scene",
      "label": "Background scene",
      "options": [
        { "value": "1", "label": "1 — lightest" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4 — deepest" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured tier",
          "info": "Adds the accent ring and primary button."
        },
        {
          "type": "number",
          "id": "qty",
          "label": "Product quantity",
          "default": 2
        },
        {
          "type": "text",
          "id": "qty_label",
          "label": "Quantity label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare-at price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_unit_note",
          "label": "Per-product note",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Feature list",
          "info": "One feature per line.",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "Product 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Product 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "Product 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "Product 4"
        },
        {
          "type": "product",
          "id": "product_5",
          "label": "Product 5"
        }
      ]
    }
  ]
}
{% endschema %}