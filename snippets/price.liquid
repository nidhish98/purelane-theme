{%- comment -%}
  Price display matching the prototype's `.pr` row:
    <strong>current</strong>  <s>compare-at</s>  <em>NN% off</em>
  - Compare-at only rendered when it exists and exceeds the price.
  - Percent-off is computed, never hardcoded.
  - `show_label` renders a small "from" prefix when a product has
    multiple prices (variants) for clarity.
  Usage: {% render 'price', product: product %}
{%- endcomment -%}
{%- liquid
  assign price = product.price
  assign compare_at = product.compare_at_price
  assign show_compare = false
  if compare_at and compare_at > price
    assign show_compare = true
  endif
-%}
<span class="pr">
  <strong>
    {%- if product.price_varies and show_label -%}{{ 'products.product.from_price' | t }} {% endif -%}
    {{ price | money }}
  </strong>
  {%- if show_compare -%}
    <s>{{ compare_at | money }}</s>
    {%- assign pct = compare_at | minus: price | times: 100.0 | divided_by: compare_at -%}
    <em>{{ pct | round }}% off</em>
  {%- endif -%}
</span>